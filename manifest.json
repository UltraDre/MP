{
  "name": "Nebula Player — online & offline media player",
  "short_name": "Nebula Player",
  "description": "Play video from the web (MP4, WebM, HLS, DASH) or from your device, download streams for offline playback, and manage a playlist with subtitles, gestures and keyboard shortcuts.",
